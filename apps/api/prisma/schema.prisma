generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username    String    @unique
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime? @map("last_seen_at")

  // GPS (Redis에도 있지만 영구 저장용)
  lastLat      Float?  @map("last_lat")
  lastLng      Float?  @map("last_lng")
  /// @zod.custom.use(z.string().nullable())
  lastLocation String? @map("last_location") // PostGIS GEOGRAPHY(POINT, 4326)

  // 게임 상태
  isDead              Boolean @default(false) @map("is_dead")
  deathCount          Int     @default(0) @map("death_count")
  longestSurvivalDays Int     @default(0) @map("longest_survival_days")
  currentTitle        String? @map("current_title")

  // 푸시 알림
  expoPushToken String? @map("expo_push_token")

  // 관계
  snail        Snail?
  buffsGiven   Buff[]        @relation("BuffGiver")
  achievements Achievement[]

  @@map("users")
}

model Snail {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId String @unique @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // 생성 정보
  spawnLat      Float    @map("spawn_lat")
  spawnLng      Float    @map("spawn_lng")
  spawnLocation String   @map("spawn_location") // PostGIS GEOGRAPHY(POINT, 4326)
  spawnedAt     DateTime @default(now()) @map("spawned_at")

  // 현재 위치 (하루 1회 크론잡 업데이트)
  currentLat      Float  @map("current_lat")
  currentLng      Float  @map("current_lng")
  currentLocation String @map("current_location") // PostGIS GEOGRAPHY(POINT, 4326)
  lastMovedAt     DateTime? @map("last_moved_at")

  // 오늘 이동 보간용 (자정마다 갱신)
  dayStartLat Float @default(0) @map("day_start_lat")
  dayStartLng Float @default(0) @map("day_start_lng")
  targetLat   Float @default(0) @map("target_lat")
  targetLng   Float @default(0) @map("target_lng")

  // 이동 통계
  totalDistanceKm Float @default(0) @map("total_distance_km")
  baseSpeedKmDay  Float @default(1.0) @map("base_speed_km_day")

  // 상태
  isActive Boolean @default(true) @map("is_active")

  // 코스메틱
  skinId String @default("default") @map("skin_id")
  name   String @default("내 달팽이")

  // 현재 위치 지역 정보 (역지오코딩)
  currentCountry     String? @map("current_country")
  currentCountryCode String? @map("current_country_code")
  currentRegion      String? @map("current_region")
  lastPushMessage    String? @map("last_push_message")

  // 관계
  buffs     Buff[]
  positions SnailPosition[]

  @@map("snails")
}

model SnailPosition {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  snailId String @map("snail_id") @db.Uuid
  snail   Snail  @relation(fields: [snailId], references: [id], onDelete: Cascade)

  lat      Float
  lng      Float
  location String // PostGIS GEOGRAPHY(POINT, 4326)

  dayNumber   Int    @map("day_number")
  description String?

  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([snailId, dayNumber])
  @@map("snail_positions")
}

model Buff {
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  targetSnailId String @map("target_snail_id") @db.Uuid
  targetSnail   Snail  @relation(fields: [targetSnailId], references: [id], onDelete: Cascade)

  giverUserId String? @map("giver_user_id") @db.Uuid
  giver       User?   @relation("BuffGiver", fields: [giverUserId], references: [id], onDelete: SetNull)

  speedBonusKm Float  @default(1.0) @map("speed_bonus_km")
  buffType     String @default("standard") @map("buff_type") // standard | reverse | freeze

  createdAt DateTime  @default(now()) @map("created_at")
  appliedAt DateTime? @map("applied_at")
  expiresAt DateTime  @map("expires_at")

  isConsumed Boolean @default(false) @map("is_consumed")

  // 버프 시 주는 사람 위치 기록 (검증용)
  giverLat Float? @map("giver_lat")
  giverLng Float? @map("giver_lng")

  @@index([targetSnailId, isConsumed, expiresAt])
  @@index([giverUserId, createdAt])
  @@map("buffs")
}

model Achievement {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String   @map("achievement_key")
  unlockedAt     DateTime? @map("unlocked_at")
  progress       Json?    @default("{}")
  isComplete     Boolean  @default(false) @map("is_complete")

  @@unique([userId, achievementKey])
  @@map("achievements")
}
