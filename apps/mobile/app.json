{
  "expo": {
    "name": "Death Snail",
    "slug": "death-snail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.deathsnail.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "달팽이가 당신의 위치를 추적하려면 위치 권한이 필요합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "달팽이가 당신의 위치를 항상 추적하려면 위치 권한이 필요합니다.",
        "NSLocationAlwaysUsageDescription": "달팽이가 당신을 찾기 위해 위치 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.deathsnail.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "달팽이가 당신을 찾으려면 위치 접근이 필요합니다.",
          "locationAlwaysPermission": "달팽이가 언제나 당신을 찾을 수 있도록 위치 접근이 필요합니다.",
          "locationWhenInUsePermission": "달팽이가 당신을 찾으려면 위치 접근이 필요합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff4444"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "deathsnail"
  }
}
